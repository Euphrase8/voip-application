# VoIP Frontend Configuration

# Backend API URL (use actual IP address for network access)
REACT_APP_API_URL=http://192.168.1.2:8080

# Asterisk SIP Server Configuration (your Asterisk server)
REACT_APP_SIP_SERVER=192.168.1.2
REACT_APP_SIP_PORT=8088
REACT_APP_SIP_WS_URL=ws://192.168.1.2:8088/ws

# WebSocket URL for signaling (use actual IP address for network access)
REACT_APP_WS_URL=ws://192.168.1.2:8080/ws

# Client IP (backend server IP)
REACT_APP_CLIENT_IP=192.168.1.2

# Debug mode
REACT_APP_DEBUG=true

# Dev server settings (HTTP). For mic access on phone, you need real HTTPS.
# HTTPS=true
HOST=0.0.0.0
PORT=3001