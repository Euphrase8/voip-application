# VoIP Frontend Configuration

# Backend API URL (use localhost for local development)
REACT_APP_API_URL=https://192.168.1.8

# Asterisk SIP Server Configuration (WSL)
REACT_APP_SIP_SERVER=192.168.1.8
REACT_APP_SIP_PORT=8088
REACT_APP_SIP_WS_URL=ws:///ws

# WebSocket URL for signaling
REACT_APP_WS_URL=ws://127.0.0.1:8080/ws

# Client IP
REACT_APP_CLIENT_IP=192.168.1.8

# Debug mode
REACT_APP_DEBUG=true

# Dev server settings
HOST=127.0.0.1
PORT=3000
