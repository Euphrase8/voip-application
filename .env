# VoIP Frontend Configuration

# Backend API URL (use localhost for local development)
REACT_APP_API_URL=http://127.0.0.1:8080

# Asterisk SIP Server Configuration (localhost for local dev)
REACT_APP_SIP_SERVER=127.0.0.1
REACT_APP_SIP_PORT=8088
REACT_APP_SIP_WS_URL=ws://127.0.0.1:8088/ws

# WebSocket URL for signaling
REACT_APP_WS_URL=ws://127.0.0.1:8080/ws

# Client IP
REACT_APP_CLIENT_IP=127.0.0.1

# Debug mode
REACT_APP_DEBUG=true

# Dev server settings
HOST=127.0.0.1
PORT=3000
