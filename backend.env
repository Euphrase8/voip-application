# VoIP Backend Configuration

# Server
HOST=127.0.0.1
PORT=8080

# JWT
JWT_SECRET=voip-secret-change-in-production
JWT_EXPIRY_HOURS=24

# Database
DB_PATH=./voip.db

# Asterisk (localhost for development)
ASTERISK_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=admin
ASTERISK_AMI_SECRET=amp111

# SIP
SIP_DOMAIN=127.0.0.1
SIP_PORT=8088

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Environment
ENVIRONMENT=development
DEBUG=true
