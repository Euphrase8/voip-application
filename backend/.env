# Server Configuration
PORT=8080
HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_HOURS=24

# Database Configuration
DB_PATH=./voip.db

# Asterisk Configuration (your Asterisk server)
ASTERISK_HOST=192.168.1.2
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=admin
ASTERISK_AMI_SECRET=amp111

# SIP Configuration
SIP_DOMAIN=192.168.1.2
SIP_PORT=8088

# Public host for frontend connections
PUBLIC_HOST=192.168.1.2

# CORS Configuration (allow frontend dev servers)
# Add the exact origin(s) you open the frontend from (scheme + host + port).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.2:3000,http://localhost:3001,http://127.0.0.1:3001,http://192.168.1.2:3001,https://localhost:3000,https://127.0.0.1:3000,https://192.168.1.2:3000,https://localhost:3001,https://127.0.0.1:3001,https://192.168.1.2:3001

# Debug Mode
DEBUG=true
