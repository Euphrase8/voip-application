# Server Configuration
PORT=8080
HOST=0.0.0.0

# JWT Configuration
# WARNING: Generate a unique secret per deployment. Never use the default value in production!
# You can generate one with: openssl rand -hex 64  or  python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=4975fb97f7c37ea2193c854400b77b0e1ed1d8537ac21cc063e108220074510cc49ff1b9a15540775d9b988fdbc4b54188754f5cdd85cbc0efa8fe014c4156f0
JWT_EXPIRY_HOURS=24

# Database Configuration
DB_PATH=./voip.db

# Asterisk Configuration (your Asterisk server)
ASTERISK_HOST=172.30.163.165
ASTERISK_AMI_PORT=5038
# WARNING: Change these to strong random values in production!
# These defaults are insecure and should never be used in a live environment
ASTERISK_AMI_USERNAME=admin
ASTERISK_AMI_SECRET=amp111

# SIP Configuration
SIP_DOMAIN=172.30.163.165
SIP_PORT=8088

# Public host for frontend connections
PUBLIC_HOST=172.30.163.165

# CORS Configuration (allow frontend dev servers)
# Add the exact origin(s) you open the frontend from (scheme + host + port).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://172.30.163.165:3000,http://localhost:3001,http://127.0.0.1:3001,http://172.30.163.165:3001

# Asterisk Auto-Start Configuration
# WSL: set the distro name to start Asterisk via WSL directly
ASTERISK_WSL_DISTRO=Ubuntu-24.04
# SSH: fallback if WSL is unavailable (host comes from ASTERISK_HOST above)
ASTERISK_SSH_USER=rose_victor
ASTERISK_SSH_PASSWORD=5011
ASTERISK_SSH_PORT=22

# Debug Mode
DEBUG=true
